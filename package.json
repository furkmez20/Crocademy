{
  "name": "studypilot-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["app", "server"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm --prefix server run dev\" \"npm --prefix app run dev\"",
    "build": "npm --prefix app run build",
    "smoke:mcp": "npm --prefix server run smoke:mcp",
    "test:brain": "npm --prefix server run test:brain"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
